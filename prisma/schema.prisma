// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
}

model Warung {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  products    Product[]
  categories  Category[]
  suppliers   Supplier[]
  customers   Customer[]
  sales       Sale[]
  purchaseOrders PurchaseOrder[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  pin           String?   // Quick PIN for cashiers
  role          UserRole  @default(CASHIER)
  warungId      String?
  
  warung        Warung?   @relation(fields: [warungId], references: [id])
  accounts      Account[]
  sessions      Session[]
  sales         Sale[]    // Cashier who handled the sale
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  warungId  String
  
  warung    Warung    @relation(fields: [warungId], references: [id])
  products  Product[]

  @@unique([name, warungId])
}

model Product {
  id          String   @id @default(cuid())
  sku         String?
  barcode     String?
  name        String
  description String?
  buyPrice    Decimal  @db.Decimal(12, 2)
  sellPrice   Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  unit        String   @default("pcs")
  stock       Decimal  @default(0) @db.Decimal(12, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 2)
  
  categoryId  String?
  warungId    String
  supplierId  String?

  category    Category? @relation(fields: [categoryId], references: [id])
  warung      Warung    @relation(fields: [warungId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  
  saleItems   SaleItem[]
  poItems     PurchaseOrderItem[]
  stockHistory StockHistory[]

  @@unique([sku, warungId])
  @@unique([barcode, warungId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  address   String?
  warungId  String
  
  warung    Warung    @relation(fields: [warungId], references: [id])
  products  Product[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String
  status      String   // PENDING, RECEIVED, CANCELLED
  totalAmount Decimal  @db.Decimal(12, 2)
  orderDate   DateTime @default(now())
  receivedDate DateTime?
  
  warungId    String
  supplierId  String
  
  warung      Warung    @relation(fields: [warungId], references: [id])
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@unique([poNumber, warungId])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal  @db.Decimal(12, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)
  
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  points    Int      @default(0)
  warungId  String
  
  warung    Warung   @relation(fields: [warungId], references: [id])
  sales     Sale[]
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String
  totalAmount   Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal  @db.Decimal(12, 2)
  paymentMethod String   // CASH, QRIS, TRANSFER, EWALLET
  status        String   // COMPLETED, PENDING, CANCELLED
  createdAt     DateTime @default(now())
  
  warungId      String
  userId        String?  // Cashier
  customerId    String?
  
  warung        Warung    @relation(fields: [warungId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  items         SaleItem[]

  @@unique([invoiceNumber, warungId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal  @db.Decimal(12, 2)
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  
  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model StockHistory {
  id          String   @id @default(cuid())
  productId   String
  changeType  String   // SALE, PURCHASE, ADJUSTMENT, LOSS
  quantity    Decimal  @db.Decimal(12, 2) // positive for increase, negative for decrease
  balance     Decimal  @db.Decimal(12, 2) // stock after change
  note        String?
  createdAt   DateTime @default(now())
  
  product     Product  @relation(fields: [productId], references: [id])
}

